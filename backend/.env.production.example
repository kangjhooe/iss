# Production Environment Variables Example
# Copy this to .env on production server and update values

APP_NAME="Indonesia Smart School"
APP_ENV=production
APP_KEY=base64:YOUR_APP_KEY_HERE
APP_DEBUG=false
APP_URL=https://api.kangjhooe.com

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database_name
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password

# CORS Configuration - IMPORTANT for cross-origin requests
# Add your frontend URL here (comma-separated for multiple origins)
CORS_ALLOWED_ORIGINS=https://app.kangjhooe.com
FRONTEND_URL=https://app.kangjhooe.com

# Sanctum Configuration
SANCTUM_STATEFUL_DOMAINS=app.kangjhooe.com,api.kangjhooe.com

# Session Configuration
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=.kangjhooe.com

# Mail Configuration (update with your SMTP settings)
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@kangjhooe.com"
MAIL_FROM_NAME="${APP_NAME}"
