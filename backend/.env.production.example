# Production Environment Variables Example
# Copy this to .env on production server and update values

APP_NAME="servr.in"
APP_ENV=production
APP_KEY=base64:YOUR_APP_KEY_HERE
APP_DEBUG=false
# Same-origin: FE + API di https://servr.in (API di /api, storage di /storage)
APP_URL=https://servr.in
APP_TIMEZONE=Asia/Jakarta

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database_name
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password

# Optional: full path to mysqldump if not in PATH (XAMPP example: C:\xampp\mysql\bin\mysqldump.exe)
# MYSQLDUMP_PATH=

# CORS / frontend — same-origin; tetap set untuk www / domain lain bila dipakai
CORS_ALLOWED_ORIGINS=https://servr.in,https://www.servr.in
FRONTEND_URL=https://servr.in

# Sanctum
SANCTUM_STATEFUL_DOMAINS=servr.in,www.servr.in
# Optional: token lifetime in minutes (e.g. 10080 = 7 days). Empty/null = no expiry.
# SANCTUM_TOKEN_EXPIRATION=10080

# Session / cookie (same-origin: .servr.in tetap OK; null = host-only)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=.servr.in
COOKIE_DOMAIN=.servr.in

# Mail
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@servr.in"
MAIL_FROM_NAME="${APP_NAME}"

SKIP_EMAIL_VERIFICATION=false

# Swagger / OpenAPI docs — nonaktifkan di production (default aman)
L5_SWAGGER_ENABLED=false
L5_SWAGGER_GENERATE_ALWAYS=false

# Super Admin seeder (jangan set SUPER_ADMIN_RESET_PASSWORD=true di production kecuali sengaja reset)
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL=superadmin@iss.id
SUPER_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
SUPER_ADMIN_RESET_PASSWORD=false

# Sekolah demo
DEMO_SCHOOL_RESET_ENABLED=true
# DEMO_SCHOOL_WEBSITE=https://servr.in

MONETIZATION_LAUNCHED=false

# Notifikasi email error kritis (opsional)
ERROR_NOTIFICATION_ENABLED=false
# ERROR_NOTIFICATION_EMAILS=ops@servr.in
