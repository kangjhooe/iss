# Local Environment Variables Example
# Copy this file to .env and update values

APP_NAME="servr.in"
APP_ENV=local
APP_KEY=base64:YOUR_APP_KEY_HERE
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=iss_db
DB_USERNAME=root
DB_PASSWORD=

# Optional: full path to mysqldump if not in PATH (XAMPP: C:\xampp\mysql\bin\mysqldump.exe)
# MYSQLDUMP_PATH=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Cookie domain for auth/impersonation. Leave empty on localhost.
# COOKIE_DOMAIN=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@servrin.local"
MAIL_FROM_NAME="${APP_NAME}"

FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost:8000,127.0.0.1:8000
# SANCTUM_TOKEN_EXPIRATION=10080

SKIP_EMAIL_VERIFICATION=true

# Swagger / OpenAPI docs (aktif otomatis saat APP_ENV=local)
# L5_SWAGGER_ENABLED=true
# L5_SWAGGER_GENERATE_ALWAYS=true

# Super Admin (php artisan db:seed --class=SuperAdminSeeder)
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL=superadmin@iss.id
SUPER_ADMIN_PASSWORD=admin123
SUPER_ADMIN_RESET_PASSWORD=false

# Sekolah demo publik
DEMO_SCHOOL_RESET_ENABLED=true
# DEMO_SCHOOL_NPSN=99990001
# DEMO_SCHOOL_NAME="SMA 1 Demo Servrin"
# DEMO_SCHOOL_PASSWORD=DemoServrin1!
# DEMO_SCHOOL_ADMIN_EMAIL=admin@demo.servrin.id
# DEMO_SCHOOL_TEACHER_EMAIL=guru01@demo.servrin.id
# DEMO_SCHOOL_BK_EMAIL=bk@demo.servrin.id
# DEMO_SCHOOL_STUDENT_NIK=3201990000000001
# DEMO_SCHOOL_STUDENT_BIRTH=2008-05-15
# DEMO_SCHOOL_PARENT_EMAIL=ortu@demo.servrin.id
# DEMO_SCHOOL_WEBSITE=https://servr.in

MONETIZATION_LAUNCHED=false
# MONETIZATION_DEFAULT_STORAGE_MB=5120

# NPSN / wilayah (opsional; ada default)
# NPSN_REFERENSI_URL=https://referensi.data.kemendikdasmen.go.id
# REGIONS_BASE_URL=https://wilayah.id/api

# Notifikasi email error kritis (opsional)
ERROR_NOTIFICATION_ENABLED=false
# ERROR_NOTIFICATION_EMAILS=ops@example.com
