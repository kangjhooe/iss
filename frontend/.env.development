# Development environment - menggunakan proxy di vite.config.js
# VITE_API_BASE_URL tidak perlu di-set karena proxy sudah handle
# VITE_PROXY_TARGET opsional (default: http://127.0.0.1:8000) jika backend di port/host lain
# VITE_APP_NAME nama aplikasi (default: servr.in), untuk white-label bisa diubah
VITE_APP_NAME=servr.in
