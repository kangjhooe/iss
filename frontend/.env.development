# Development environment - menggunakan proxy di vite.config.js
# VITE_API_BASE_URL tidak perlu di-set karena proxy sudah handle
# VITE_PROXY_TARGET opsional (default: http://127.0.0.1:8000) jika backend di port/host lain
# VITE_APP_NAME / VITE_APP_TAGLINE / VITE_APP_VERSION untuk white-label
VITE_APP_URL=http://localhost:5173
VITE_APP_NAME=servr.in
VITE_APP_TAGLINE=One Platform for Smarter Education
# VITE_APP_VERSION=0.1.26.02.23
# Push Web: isi kunci publik VAPID agar notifikasi push aktif
# VITE_VAPID_PUBLIC_KEY=
